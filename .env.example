# Azure AI Search (the vector index)
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=<index-name>
# Read-only key, used by the app.
AZURE_SEARCH_QUERY_KEY=<query-key>
# Admin key, used only by ingest.py to create the index and upload chunks.
AZURE_SEARCH_ADMIN_KEY=<admin-key>

# Embeddings (must match the model the index was built with)
AZURE_OPENAI_ENDPOINT=https://<embedding-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<embedding-resource-key>
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Chat model (can be a different Azure OpenAI resource)
AZURE_OPENAI_CHAT_ENDPOINT=https://<chat-resource>.openai.azure.com/
AZURE_OPENAI_CHAT_API_KEY=<chat-resource-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat-deployment-name>


